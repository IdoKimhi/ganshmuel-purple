# ============================================
# MySQL (billing-db)
# ============================================

# Change this to a strong password in your real .env file
MYSQL_ROOT_PASSWORD=change_me_root_password

# Name of the billing database
MYSQL_DATABASE=billdb


# ============================================
# Billing service configuration
# ============================================

# Hostname of the billing-db service (matches docker-compose)
DB_HOST=billing-db

# Database user
DB_USER=root

# Replace with a strong password in your real .env file
DB_PASSWORD=change_me_db_password

# Database name
DB_NAME=billdb
DB_PORT=3306


# ============================================
# Weight service (external microservice)
# ============================================

WEIGHT_SERVICE_URL=http://weight:<weightServicePort>


# ============================================
# Billing service runtime
# ============================================

# Where rates.xlsx is mounted inside the container
RATES_DIR=/in

# Flask port inside the billing container
PORT=5000

